DATABASE_URL="file:../db/custom.db"
# Comma-separated list of Gemini API Keys (auto-rotated/randomly selected)
GEMINI_API_KEYS="your-key-1,your-key-2,your-key-3"

# Or individual numbered keys
GEMINI_API_KEY_1="your-key-1"
GEMINI_API_KEY_2="your-key-2"

# Or single key fallback
GEMINI_API_KEY="your-gemini-api-key-here"
