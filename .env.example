# Neon PostgreSQL connection (pooled endpoint)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-32-char-string-here"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of Gemini API Keys (auto-rotated/randomly selected)
GEMINI_API_KEYS="your-key-1,your-key-2,your-key-3"

# Or individual numbered keys
GEMINI_API_KEY_1="your-key-1"
GEMINI_API_KEY_2="your-key-2"

# Or single key fallback
GEMINI_API_KEY="your-gemini-api-key-here"
